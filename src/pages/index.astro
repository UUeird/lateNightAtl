---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { TYPES } from '../data/taxonomy';
import { DAY_NAMES, formatTime } from '../lib/hours';
import { url } from '../lib/url';

const places = (await getCollection('places')).sort((a, b) => a.data.name.localeCompare(b.data.name));

// Only offer filter values that some place actually has.
const areas = [...new Set(places.map((p) => p.data.area))].sort();
const types = Object.entries(TYPES).filter(([k]) => places.some((p) => p.data.type === k));
const cuisines = [...new Set(places.flatMap((p) => p.data.cuisine))].sort();
const times = [21, 22, 23, 24, 25, 26, 27, 28].map((h) => h * 60);

const clientData = places.map(({ id, data }) => ({
  id,
  name: data.name,
  type: data.type,
  typeLabel: TYPES[data.type],
  cuisine: data.cuisine,
  area: data.area,
  lat: data.lat,
  lng: data.lng,
  hours: data.hours,
  url: url(`places/${id}/`),
}));
const json = JSON.stringify(clientData).replace(/</g, '\\u003c');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---
<Base>
  <form class="filters" id="filters" role="search" aria-label="Filter places">
    <div class="filter-row">
      <div class="filter-main">
      <label class="search">
        <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span class="sr-only">Search</span>
        <input type="search" name="q" placeholder="Search places or food" autocomplete="off" />
      </label>
      <button type="button" class="chip near-btn" id="near-me" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 3 3 10.5l7.5 3L13.5 21z" /></svg>
        <span class="near-text">Near me</span>
      </button>
      <button type="button" class="chip more-btn" id="more-filters" aria-expanded="false" aria-controls="extra-filters">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8" /><circle cx="16" cy="7" r="2" /><circle cx="10" cy="17" r="2" /></svg>
        <span class="more-text">Filters</span><span class="badge" id="filter-badge" hidden></span>
      </button>
      </div>
      <div class="filter-when">
      <select class="chip when-chip night-chip" name="night" aria-label="Which night">
        <option value="now">Right now</option>
        <option value="tonight" selected>Tonight</option>
        {DAY_NAMES.map((d, i) => <option value={i}>{d.slice(0, 3)} night</option>)}
      </select>
      <label class="chip when-chip at-chip">
        <span class="chip-label">Open at</span>
        <select name="at">
          {times.map((t) => <option value={t} selected={t === 1260}>{t === 1440 ? '12 AM' : formatTime(t)}</option>)}
        </select>
      </label>
      <label class="chip when-chip within-chip" id="within-chip" hidden>
        <span class="chip-label">Within</span>
        <select name="within" disabled>
          <option value="">any distance</option>
          <option value="1">1 mile</option>
          <option value="3">3 miles</option>
          <option value="5">5 miles</option>
          <option value="10">10 miles</option>
        </select>
      </label>
      </div>
    </div>
    <div class="filter-row extra-filters" id="extra-filters" hidden>
      <select class="chip" name="area" aria-label="Area">
        <option value="">All areas</option>
        {areas.map((a) => <option value={a}>{a}</option>)}
      </select>
      <select class="chip" name="type" aria-label="Type">
        <option value="">All types</option>
        {types.map(([k, label]) => <option value={k}>{label}</option>)}
      </select>
      <select class="chip" name="cuisine" aria-label="Cuisine">
        <option value="">Any cuisine</option>
        {cuisines.map((c) => <option value={c}>{cap(c)}</option>)}
      </select>
      <button type="button" class="clear-btn" id="clear-filters" hidden>Clear filters</button>
    </div>
  </form>

  <p class="geo-msg" id="geo-msg" role="status" hidden></p>
  <div class="results-bar">
    <p class="count" id="count" aria-live="polite">{places.length} places</p>
    <div class="view-toggle" role="group" aria-label="View">
      <button type="button" data-view="list" aria-pressed="true">List</button>
      <button type="button" data-view="map" aria-pressed="false">Map</button>
    </div>
  </div>

  <div class="explorer" id="explorer" data-view="list">
    <ol class="list" id="list">
      {places.map(({ id, data }) => (
        <li class="card" data-id={id}>
          <h2><a class="card-link" href={url(`places/${id}/`)}>{data.name}</a></h2>
          <p class="meta">
            {[TYPES[data.type], ...data.cuisine.map(cap)].join(' · ')}
            <span class="area">{data.area}</span>
          </p>
          <div class="card-foot">
            <p class="status"><span data-status></span><span class="distance" data-distance></span></p>
            <button type="button" class="locate" data-locate={id}>Map</button>
          </div>
        </li>
      ))}
    </ol>
    <p class="empty" id="empty" hidden>Nothing matches. Try an earlier time or fewer filters.</p>
    <div class="map" id="map" aria-label="Map of places"></div>
  </div>

  <script type="application/json" id="places-data" set:html={json} />
  <script>
    import { initExplorer } from '../scripts/explorer';
    initExplorer();
  </script>
</Base>
