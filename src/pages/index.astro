---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { DEFAULT_OFF_TYPES, TAGS, TAG_SHORT, TYPES, cuisineGroup, typeLabel, type TypeKey } from '../data/taxonomy';
import { DAY_NAMES, OPEN_UNTIL_TIMES, formatTime } from '../lib/hours';
import { url } from '../lib/url';


const places = (await getCollection('places')).sort((a, b) => a.data.name.localeCompare(b.data.name));

// Only offer filter values that some place actually has.
const types = Object.entries(TYPES).filter(([k]) => places.some((p) => p.data.type.includes(k as keyof typeof TYPES)));
// In the Type menu: the night-out types, then Food with its cuisines, then errands.
const typeRank = (k: string) => (DEFAULT_OFF_TYPES.includes(k as TypeKey) ? 2 : k === 'food' ? 1 : 0);
types.sort((a, b) => typeRank(a[0]) - typeRank(b[0]));
// The Food list: food places' cuisines, by group (e.g. Diner and American are both
// Euromerican). Bars and cafés list cuisines too, but those aren't what Food filters.
const cuisines = [...new Set(places.filter((p) => p.data.type.includes('food')).flatMap((p) => p.data.cuisine.map(cuisineGroup)))].sort();

const clientData = places.map(({ id, data }) => ({
  id,
  name: data.name,
  types: data.type,
  typeLabel: typeLabel(data.type),
  tags: data.tags.map((t) => TAGS[t]),
  cuisine: data.cuisine,
  cuisineGroups: [...new Set(data.cuisine.map(cuisineGroup))],
  area: data.area,
  lat: data.lat,
  lng: data.lng,
  hours: data.hours,
  url: url(`places/${id}/`),
  address: data.address,
}));
const json = JSON.stringify(clientData).replace(/</g, '\\u003c');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
/** "southeast asian" → "Southeast Asian" */
const titleCase = (s: string) => s.replace(/\b\w/g, (ch) => ch.toUpperCase());
---
<Base fitScreen hasMap>
  <div class="toolbar" id="toolbar">
  <form class="filters" id="filters" role="search" aria-label="Filter places">
    {/* One bar of controls. Desktop: a row of labeled chips. Phones: a row of icons, each
        menu opening as a sheet below; the search box floats at the bottom of the screen. */}
    <div class="filter-bar" id="filter-bar">
      <label class="search" id="search-box" data-map-overlay>
        <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span class="sr-only">Search</span>
        <input type="search" name="q" placeholder="Search places or food" autocomplete="off" />
      </label>
      {/* When: which night, and open until what time, in one menu of styled choices. */}
      <details class="chip-menu when-menu" id="when-menu">
        <summary class="chip icon-chip when-chip" title="When">
          <svg class="cal-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>
          <span class="chip-short when-short" aria-hidden="true">Tonight, 9 PM</span>
          <span class="sr-only">When: </span><span class="menu-text when-text">Tonight · till 9 PM</span>
        </summary>
        <div class="menu-panel when-panel">
          <fieldset class="pick-group">
            <legend class="pick-legend">Night</legend>
            <div class="pills">
              {[['now', 'Right now'], ['tonight', 'Tonight'], ...DAY_NAMES.map((d, i) => [String(i), d.slice(0, 3)])].map(([v, text]) => (
                <label class="pill"><input type="radio" name="night" value={v} checked={v === 'tonight'} /><span>{text}</span></label>
              ))}
            </div>
          </fieldset>
          <fieldset class="pick-group" id="when-times">
            <legend class="pick-legend">Open until</legend>
            <div class="pills pills-times">
              {OPEN_UNTIL_TIMES.map((t) => (
                <label class="pill"><input type="radio" name="at" value={t} checked={t === 1260} /><span>{formatTime(t).replace('midnight', '12 AM')}</span></label>
              ))}
            </div>
          </fieldset>
        </div>
      </details>
      <label class="chip icon-chip when-chip within-chip" id="within-chip" title="Within" hidden>
        <svg class="cal-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke-dasharray="3 3" /><circle cx="12" cy="12" r="2" /></svg>
        <span class="chip-label">Within</span><span class="chip-short" aria-hidden="true">Within</span>
        <select name="within" aria-label="Within" disabled>
          <option value="">any</option>
          <option value="1">1 mile</option>
          <option value="3">3 miles</option>
          <option value="5">5 miles</option>
          <option value="10">10 miles</option>
        </select>
      </label>
      {/* What kind of place. Food is one of the types, with its cuisines under it. */}
      <details class="chip-menu" data-filter="type" data-all="All types" data-plural="picked">
        <summary class="chip icon-chip" title="Type">
          <svg class="cal-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.5" /><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5" /><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5" /><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5" /></svg>
          <span class="chip-short" aria-hidden="true">Type</span>
          <span class="sr-only">Type: </span><span class="menu-text">All types</span>
        </summary>
        <fieldset class="menu-panel">
          <legend class="sr-only">Type</legend>
          {types.map(([value, text]) => (
            <>
              <label class="menu-option"><input type="checkbox" name="type" value={value} /><span>{text}</span></label>
              {value === 'food' && cuisines.length > 0 && (
                <fieldset class="menu-sub">
                  <legend class="sr-only">Cuisine (any if none picked)</legend>
                  {cuisines.map((c) => (
                    <label class="menu-option"><input type="checkbox" name="cuisine" value={c} /><span>{titleCase(c)}</span></label>
                  ))}
                </fieldset>
              )}
            </>
          ))}
          <button type="button" class="menu-clear">Clear type</button>
        </fieldset>
      </details>
      <button type="button" class="clear-btn" id="clear-filters" title="Clear type" hidden>Clear</button>
    </div>
  </form>

  <p class="geo-msg" id="geo-msg" role="status" hidden></p>
  <div class="results-bar">
    <p class="count" id="count" aria-live="polite">{places.length} places</p>
  </div>
  </div>

  <!-- Phones show the map; the list slides over it from the right (tap or drag the tab on
       the map's right edge) and is swiped or tapped away.
       Desktop shows both side by side. -->
  <div class="explorer" id="explorer" data-list="closed">
    <div class="list-scrim" id="list-scrim" aria-hidden="true"></div>
    <button type="button" class="list-tab" id="list-tab" data-map-overlay aria-label="Show the list" aria-expanded="false" aria-controls="list-panel"></button>
    <div class="list-panel" id="list-panel" aria-label="Results">
    <div class="list-head">
      <span class="list-head-title" id="list-count"></span>
      <button type="button" class="list-close" id="list-close" aria-label="Close the list">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
      </button>
    </div>
    <ol class="list" id="list">
      {places.map(({ id, data }) => (
        <li class="card" data-id={id}>
          <h2><a class="card-link" href={url(`places/${id}/`)}>{data.name}</a></h2>
          <p class="card-sub">
            <span class="status"><span data-status></span><span class="distance" data-distance></span></span>
            {data.tags.map((t) => <span class="tag" title={TAGS[t]}>{TAG_SHORT[t]}</span>)}
            <span class="meta">{[data.area, typeLabel(data.type), ...data.cuisine.map(cap)].join(' · ')}</span>
          </p>
          <button type="button" class="locate" data-locate={id}>Map</button>
        </li>
      ))}
      <li class="list-note" id="list-note">Hours change. Call ahead or check the business's own site before you go.</li>
    </ol>
    </div>
    <p class="empty" id="empty" hidden>Nothing matches. Try an earlier time or fewer filters.</p>
    <div class="map" id="map" aria-label="Map of places"></div>
  </div>

  <script type="application/json" id="places-data" set:html={json} />
  <script>
    import { initExplorer } from '../scripts/explorer';
    initExplorer();
  </script>
</Base>
