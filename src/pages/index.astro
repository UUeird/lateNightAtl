---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { DEFAULT_OFF_TYPES, TAGS, TAG_EMOJI, TYPES, TYPE_EMOJI, cuisineEmoji, cuisineGroup, typeLabel, type TypeKey } from '../data/taxonomy';
import { DAY_NAMES, OPEN_UNTIL_TIMES, WITHIN_STOPS, openUntilLabel } from '../lib/hours';
import { url } from '../lib/url';
import { MINIMAP, miniMapPoint } from '../data/minimap';


const places = (await getCollection('places')).sort((a, b) => a.data.name.localeCompare(b.data.name));

// Only offer filter values that some place actually has.
const types = Object.entries(TYPES).filter(([k]) => places.some((p) => p.data.type.includes(k as keyof typeof TYPES)));
// In the Type menu: the night-out types, then Food with its cuisines, then errands.
const typeRank = (k: string) => (DEFAULT_OFF_TYPES.includes(k as TypeKey) ? 2 : k === 'food' ? 1 : 0);
types.sort((a, b) => typeRank(a[0]) - typeRank(b[0]));
// The Food list: food places' cuisines, by group (e.g. Diner and American are both
// Euromerican). Bars and cafés list cuisines too, but those aren't what Food filters.
const cuisines = [...new Set(places.filter((p) => p.data.type.includes('food')).flatMap((p) => p.data.cuisine.map(cuisineGroup)))].sort();

const clientData = places.map(({ id, data }) => ({
  id,
  name: data.name,
  types: data.type,
  typeLabel: typeLabel(data.type),
  tags: data.tags.map((t) => TAGS[t]),
  cuisine: data.cuisine,
  cuisineGroups: [...new Set(data.cuisine.map(cuisineGroup))],
  area: data.area,
  lat: data.lat,
  lng: data.lng,
  hours: data.hours,
  url: url(`places/${id}/`),
  address: data.address,
}));
const json = JSON.stringify(clientData).replace(/</g, '\\u003c');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
/** "southeast asian" → "Southeast Asian" */
const titleCase = (s: string) => s.replace(/\b\w/g, (ch) => ch.toUpperCase());
/**
 * A card's second line, after its status: what the place is, led by an emoji. Food places
 * say their cuisines ("🍕 Pizza"), as Food goes without saying; other places say their
 * type, then any cuisine ("🍸 Bar · American").
 */
function cardMeta(types: TypeKey[], cuisine: string[]) {
  const other = types.filter((t) => t !== 'food');
  const words = [...(other.length ? [typeLabel(other)] : []), ...cuisine.map(cap)];
  if (!words.length) return `${TYPE_EMOJI.food} Food`;
  const emoji = other.length ? TYPE_EMOJI[other[0]] : cuisineEmoji(cuisine[0]);
  return `${emoji} ${words.join(' · ')}`;
}
---
<Base fitScreen hasMap>
  <div class="toolbar" id="toolbar">
  <form class="filters" id="filters" role="search" aria-label="Filter places">
    {/* One bar of controls. Desktop: a row of labeled chips. Phones: a row of icons, each
        menu opening as a sheet below; the search box floats at the bottom of the screen. */}
    <div class="filter-bar" id="filter-bar" data-map-overlay>
      <label class="search" id="search-box">
        <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span class="sr-only">Search</span>
        <input type="search" name="q" placeholder="Search places or food" autocomplete="off" />
      </label>
      {/* When: which night, and open until what time, in one menu of styled choices. */}
      <details class="chip-menu when-menu" id="when-menu">
        <summary class="chip icon-chip when-chip" title="When">
          <svg class="cal-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>
          <span class="chip-short when-short" aria-hidden="true">Tonight, 9 PM</span>
          <span class="sr-only">When: </span><span class="menu-text when-text">Tonight · till 9 PM</span>
        </summary>
        <div class="menu-panel when-panel">
          <fieldset class="pick-group">
            <legend class="pick-legend">Night</legend>
            <div class="pills">
              {[['now', 'Right now'], ['tonight', 'Tonight'], ...DAY_NAMES.map((d, i) => [String(i), d.slice(0, 3)])].map(([v, text]) => (
                <label class="pill"><input type="radio" name="night" value={v} checked={v === 'tonight'} /><span>{text}</span></label>
              ))}
            </div>
          </fieldset>
          <fieldset class="pick-group" id="when-times">
            <legend class="pick-legend">Open until</legend>
            <div class="pills pills-times">
              {OPEN_UNTIL_TIMES.map((t) => (
                <label class="pill"><input type="radio" name="at" value={t} checked={t === 1260} /><span>{openUntilLabel(t)}</span></label>
              ))}
            </div>
          </fieldset>
        </div>
      </details>
      {/* Within: how far from you, once Near me is on. Pills, like When. */}
      <details class="chip-menu within-menu" id="within-chip" hidden>
        <summary class="chip icon-chip when-chip within-chip" title="Within">
          <svg class="cal-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke-dasharray="3 3" /><circle cx="12" cy="12" r="2" /></svg>
          <span class="chip-short within-short" aria-hidden="true">Within</span>
          <span class="sr-only">Within: </span><span class="menu-text within-text">Any distance</span>
        </summary>
        <div class="menu-panel when-panel within-panel">
          <fieldset class="pick-group" id="within-group" disabled>
            <legend class="pick-legend">Within</legend>
            {/* A slider from near to anywhere: drag it, click along it, or click a stop. */}
            <input type="range" class="within-range" name="within" min="0" max={WITHIN_STOPS.length - 1} step="1" value={WITHIN_STOPS.length - 1}
              aria-label="Within" aria-valuetext="Any distance" />
            <div class="within-stops">
              {WITHIN_STOPS.map((miles, i) => (
                <button type="button" class="within-stop" data-stop={i}>{miles ? `${miles} mi` : 'Any'}</button>
              ))}
            </div>
          </fieldset>
        </div>
      </details>
      {/* What kind of place. Food is one of the types, with its cuisines under it. */}
      <details class="chip-menu" data-filter="type" data-all="All types" data-plural="picked">
        <summary class="chip icon-chip" title="Type">
          <svg class="cal-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.5" /><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5" /><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5" /><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5" /></svg>
          <span class="chip-short" aria-hidden="true">Type</span>
          <span class="sr-only">Type: </span><span class="menu-text">All types</span>
        </summary>
        <fieldset class="menu-panel">
          <legend class="sr-only">Type</legend>
          {/* Every type but Food, as pills; then Food, heading its cuisines. Food's box
              ticks or unticks them all, and shows a minus when only some are picked. */}
          <div class="type-pills">
            {types.filter(([value]) => value !== 'food').map(([value, text]) => (
              <label class="menu-option"><input type="checkbox" name="type" value={value} /><span class="opt-emoji" aria-hidden="true">{TYPE_EMOJI[value as TypeKey]}</span><span class="opt-text">{text}</span></label>
            ))}
          </div>
          {types.some(([value]) => value === 'food') && (
            <fieldset class="menu-sub">
              <legend class="sub-head">
                <label class="sub-head-option"><input type="checkbox" name="type" value="food" /><span class="opt-emoji" aria-hidden="true">{TYPE_EMOJI.food}</span><span class="opt-text">Food</span></label>
              </legend>
              {cuisines.map((c) => (
                <label class="menu-option"><input type="checkbox" name="cuisine" value={c} /><span class="opt-emoji" aria-hidden="true">{cuisineEmoji(c)}</span><span class="opt-text">{titleCase(c)}</span></label>
              ))}
            </fieldset>
          )}
          {/* Named for what it does: unticking everything shows every type. */}
          <button type="button" class="menu-clear">Show all types</button>
        </fieldset>
      </details>
      <button type="button" class="clear-btn" id="clear-filters" title="Show all types" hidden>Show all</button>
    </div>
  </form>

  <p class="geo-msg" id="geo-msg" role="status" hidden></p>
  </div>

  <!-- Phones show the map; the list slides over it from the right (tap or drag the tab on
       the map's right edge) and is swiped or tapped away.
       Desktop shows both side by side. -->
  <div class="explorer" id="explorer" data-list="closed">
    <div class="list-scrim" id="list-scrim" aria-hidden="true"></div>
    <button type="button" class="list-tab" id="list-tab" data-map-overlay aria-label="Show the list" aria-expanded="false" aria-controls="list-panel"></button>
    <div class="list-panel" id="list-panel" aria-label="Results">
    <div class="list-head">
      <span class="list-head-title" id="list-count"></span>
      <button type="button" class="list-close" id="list-close" aria-label="Close the list">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
      </button>
    </div>
    {/* The little map every card draws: defined once, used by each. */}
    <svg class="sprite" aria-hidden="true">
      <symbol id="atl-mini" viewBox={`0 0 ${MINIMAP.width} ${MINIMAP.height}`}>
        <path class="mini-roads" d={MINIMAP.roads} />
        <path class="mini-loop" d={MINIMAP.loop} />
      </symbol>
    </svg>
    <ol class="list" id="list">
      {places.map(({ id, data }) => {
        const pin = miniMapPoint(data.lng, data.lat);
        return (
          <li class="card" data-id={id}>
            <h2><a class="card-link" href={url(`places/${id}/`)}>{data.name}</a></h2>
            <p class="card-sub">
              {/* The status in full for screen readers; a compact pill on screen ("’til 2am"). */}
              <span class="sr-only" data-status></span><span class="status-pill" data-status-short aria-hidden="true"></span>
              <span class="distance" data-distance></span>
              {/* Tags as emoji; the name shows on hover (desktop) and to screen readers. */}
              {data.tags.map((t) => <span class="tag-emoji" role="img" aria-label={TAGS[t]} data-tip={TAGS[t]}>{TAG_EMOJI[t]}</span>)}
              <span class="meta">{cardMeta(data.type, data.cuisine)}</span>
            </p>
            {/* Where it is in town, on a little map of the interstates. Phones: shows it on
                the big map (behind the list). Desktop, where the big map is beside the list
                and hovering the card lights its dot: opens the place, like the card. */}
            <button type="button" class="locate mini-map" data-locate={id} aria-label={`${data.area}: show on the map`} data-tip={data.area}>
              <svg viewBox={`0 0 ${MINIMAP.width} ${MINIMAP.height}`} aria-hidden="true">
                <use href="#atl-mini" />
                <circle class="mini-pin" cx={pin.x} cy={pin.y} r="7" />
              </svg>
            </button>
          </li>
        );
      })}
      <li class="list-note" id="list-note">Hours change. Call ahead or check the business's own site before you go.</li>
    </ol>
    </div>
    <p class="empty" id="empty" hidden>Nothing matches. Try an earlier time or fewer filters.</p>
    <div class="map" id="map" aria-label="Map of places"></div>
    {/* Desktop: floats over the top of the map. Phones show it in the list's tray instead. */}
    <div class="results-bar">
      <p class="count" id="count" aria-live="polite">{places.length} places</p>
    </div>
  </div>

  <script type="application/json" id="places-data" set:html={json} />
  <script>
    import { initExplorer } from '../scripts/explorer';
    initExplorer();
  </script>
</Base>
