---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { TAGS, TAG_SHORT, TYPES, typeLabel } from '../data/taxonomy';
import { DAY_NAMES, formatTime } from '../lib/hours';
import { url } from '../lib/url';


const places = (await getCollection('places')).sort((a, b) => a.data.name.localeCompare(b.data.name));

// Only offer filter values that some place actually has.
const types = Object.entries(TYPES).filter(([k]) => places.some((p) => p.data.type.includes(k as keyof typeof TYPES)));
const cuisines = [...new Set(places.flatMap((p) => p.data.cuisine))].sort();
const times = [21, 22, 23, 24, 25, 26, 27, 28].map((h) => h * 60);

const clientData = places.map(({ id, data }) => ({
  id,
  name: data.name,
  types: data.type,
  typeLabel: typeLabel(data.type),
  tags: data.tags.map((t) => TAGS[t]),
  cuisine: data.cuisine,
  area: data.area,
  lat: data.lat,
  lng: data.lng,
  hours: data.hours,
  url: url(`places/${id}/`),
  address: data.address,
}));
const json = JSON.stringify(clientData).replace(/</g, '\\u003c');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---
<Base fitScreen hasMap>
  <div class="toolbar" id="toolbar">
  <form class="filters" id="filters" role="search" aria-label="Filter places">
    {/* One bar of controls. Desktop: a row of labeled chips. Phones: a row of icons, each
        menu opening as a sheet below; the search box floats at the bottom of the screen. */}
    <div class="filter-bar" id="filter-bar">
      <label class="search" id="search-box" data-map-overlay>
        <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span class="sr-only">Search</span>
        <input type="search" name="q" placeholder="Search places or food" autocomplete="off" />
      </label>
      {/* Which night, and open at what time: icons on phones, whose selects lie invisibly
          over them so a tap opens the native picker. */}
      <label class="chip icon-chip when-chip night-chip" id="night-chip" title="Which night">
        <svg class="cal-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>
        <select name="night" aria-label="Which night">
          <option value="now">Right now</option>
          <option value="tonight" selected>Tonight</option>
          {DAY_NAMES.map((d, i) => <option value={i}>{d.slice(0, 3)} night</option>)}
        </select>
      </label>
      <label class="chip icon-chip when-chip at-chip" id="at-chip" title="Open at">
        <svg class="cal-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>
        <span class="chip-label">Open at</span>
        <select name="at" aria-label="Open at">
          {times.map((t) => <option value={t} selected={t === 1260}>{t === 1440 ? '12 AM' : formatTime(t)}</option>)}
        </select>
      </label>
      <label class="chip icon-chip when-chip within-chip" id="within-chip" title="Within" hidden>
        <svg class="cal-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke-dasharray="3 3" /><circle cx="12" cy="12" r="2" /></svg>
        <span class="chip-label">Within</span>
        <select name="within" aria-label="Within" disabled>
          <option value="">any</option>
          <option value="1">1 mile</option>
          <option value="3">3 miles</option>
          <option value="5">5 miles</option>
          <option value="10">10 miles</option>
        </select>
      </label>
      {[
        { name: 'type', label: 'Type', all: 'All types', plural: 'types', options: types,
          icon: '<rect x="4" y="4" width="6.5" height="6.5" rx="1.5" /><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5" /><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5" /><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5" />' },
        { name: 'cuisine', label: 'Cuisine', all: 'Any cuisine', plural: 'cuisines', options: cuisines.map((c) => [c, cap(c)]),
          icon: '<path d="M7 3v8M5 3v5a2 2 0 0 0 4 0V3M7 11v10M16.5 21V3c-2 1.5-3 4-3 7v4h3" />' },
      ].map((m) => (
        <details class="chip-menu" data-filter={m.name} data-all={m.all} data-plural={m.plural}>
          <summary class="chip icon-chip" title={m.label}>
            <svg class="cal-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={m.icon} />
            <span class="sr-only">{m.label}: </span><span class="menu-text">{m.all}</span>
          </summary>
          <fieldset class="menu-panel">
            <legend class="sr-only">{m.label}</legend>
            {m.options.map(([value, text]) => (
              <label class="menu-option"><input type="checkbox" name={m.name} value={value} /><span>{text}</span></label>
            ))}
            <button type="button" class="menu-clear">Clear {m.label.toLowerCase()}</button>
          </fieldset>
        </details>
      ))}
      <button type="button" class="clear-btn" id="clear-filters" title="Clear type and cuisine" hidden>Clear</button>
    </div>
  </form>

  <p class="geo-msg" id="geo-msg" role="status" hidden></p>
  <div class="results-bar">
    <p class="count" id="count" aria-live="polite">{places.length} places</p>
    <div class="view-toggle" role="group" aria-label="View">
      <button type="button" data-view="list" aria-pressed="false">List</button>
      <button type="button" data-view="map" aria-pressed="true">Map</button>
    </div>
  </div>
  </div>

  <!-- Phones open on the map; the List button switches. (Desktop shows both side by side.) -->
  <div class="explorer" id="explorer" data-view="map">
    <div class="list-panel" id="list-panel">
    <ol class="list" id="list">
      {places.map(({ id, data }) => (
        <li class="card" data-id={id}>
          <h2><a class="card-link" href={url(`places/${id}/`)}>{data.name}</a></h2>
          <p class="card-sub">
            <span class="status"><span data-status></span><span class="distance" data-distance></span></span>
            {data.tags.map((t) => <span class="tag" title={TAGS[t]}>{TAG_SHORT[t]}</span>)}
            <span class="meta">{[data.area, typeLabel(data.type), ...data.cuisine.map(cap)].join(' · ')}</span>
          </p>
          <button type="button" class="locate" data-locate={id}>Map</button>
        </li>
      ))}
      <li class="list-note" id="list-note">Hours change. Call ahead or check the business's own site before you go.</li>
    </ol>
    </div>
    <p class="empty" id="empty" hidden>Nothing matches. Try an earlier time or fewer filters.</p>
    <div class="map" id="map" aria-label="Map of places"></div>
  </div>

  <script type="application/json" id="places-data" set:html={json} />
  <script>
    import { initExplorer } from '../scripts/explorer';
    initExplorer();
  </script>
</Base>
