---
import '../styles/global.css';
import { url } from '../lib/url';
import { MAP_STYLE_URL } from '../lib/geo';

interface Props {
  title?: string;
  description?: string;
  /** Desktop: fit the page to the window; the page's own panes scroll instead. */
  fitScreen?: boolean;
  /** The page shows a map: connect to the map server and fetch its style early. */
  hasMap?: boolean;
}
const { title, description = 'Where to eat, drink and get things done late at night in Atlanta.', fitScreen = false, hasMap = false } = Astro.props;
const fullTitle = title ? `${title} · Late Night ATL` : 'Late Night ATL';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {hasMap && (
      <>
        {/* Start the connection and the style download while the page's scripts load,
            so the map isn't waiting on a cold connection once its code arrives. */}
        <link rel="preconnect" href="https://tiles.openfreemap.org" crossorigin />
        <link rel="preload" href={MAP_STYLE_URL} as="fetch" crossorigin />
      </>
    )}
    <slot name="head" />
  </head>
  <body class:list={{ 'fit-screen': fitScreen }}>
    <header class="site-header">
      <a class="brand" href={url()}>Late Night <span>ATL</span></a>
      {/* Tim Holman's "GitHub Corners" (MIT), recolored for the dark theme. */}
      <a href="https://github.com/UUeird/lateNightAtl" class="github-corner" aria-label="Suggest a place or a fix on GitHub" title="Suggest a place or a fix on GitHub">
        <svg viewBox="0 0 250 250" aria-hidden="true">
          <path d="M0,0 L115,115 L130,115 L142,142 L250,250 L250,0 Z" />
          <path class="octo-arm" fill="currentColor" d="M128.3,109.0 C113.8,99.7 119.0,89.6 119.0,89.6 C122.0,82.7 120.5,78.6 120.5,78.6 C119.2,72.0 123.4,76.3 123.4,76.3 C127.3,80.9 125.5,87.3 125.5,87.3 C122.9,97.6 130.6,101.9 134.4,103.2" />
          <path fill="currentColor" d="M115.0,115.0 C114.9,115.1 118.7,116.5 119.8,115.4 L133.7,101.6 C136.9,99.2 139.9,98.4 142.2,98.6 C133.8,88.0 127.5,74.4 143.8,58.0 C148.5,53.4 154.0,51.2 159.7,51.0 C160.3,49.4 163.2,43.6 171.4,40.1 C171.4,40.1 176.1,42.5 178.8,56.2 C183.1,58.6 187.2,61.8 190.9,65.4 C194.5,69.0 197.7,73.2 200.1,77.6 C213.8,80.2 216.3,84.9 216.3,84.9 C212.7,93.1 206.9,96.0 205.4,96.6 C205.1,102.4 203.0,107.8 198.3,112.5 C181.9,128.9 168.3,122.5 157.7,114.1 C157.9,116.9 156.7,120.9 152.7,124.9 L141.0,136.5 C139.8,137.7 141.6,141.9 141.8,141.8 Z" />
        </svg>
      </a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
