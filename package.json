{
  "name": "late-night-atl",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test --disable-warning=ExperimentalWarning 'tests/unit/**/*.test.ts'",
    "test:e2e": "playwright test",
    "test:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "astro": "^7.4.11",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3"
  }
}
